# ローカル開発用（Cloud Run では Terraform が Secret Manager から注入する）
DATABASE_URL=postgresql://user:pass@localhost:5432/proto_recall
AUTH_SECRET=dev-secret-change-me
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true
RECALL_API_KEY=
RECALL_REGION=ap-northeast-1
GATEWAY_URL=http://localhost:8080
GATEWAY_SIGNING_SECRET=dev-secret
# 議事録の自動生成に使用（gateway と同じキーで良い）
GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=gemini-2.5-flash
